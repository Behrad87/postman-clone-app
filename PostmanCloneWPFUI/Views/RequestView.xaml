<UserControl x:Class="PostmanCloneWPFUI.Views.RequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PostmanCloneWPFUI.Views">

    <Grid Background="{StaticResource BrushBgBase}">
        <Grid.RowDefinitions>
            <!-- URL bar -->
            <RowDefinition Height="60"/>
            <!-- Request / Response split -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── URL BAR ── -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Method -->
                <ComboBox DockPanel.Dock="Left" Style="{StaticResource MethodComboBox}"
                          ItemsSource="{Binding Methods}"
                          SelectedItem="{Binding Method}"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="Bold"
                                       Foreground="{Binding Converter={StaticResource MethodColor}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Send / Cancel -->
                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                        Style="{StaticResource SendButton}"
                        Command="{Binding SendCommand}"
                        Visibility="{Binding IsSending, Converter={StaticResource InvertBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Send" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                        Style="{StaticResource SendButton}"
                        Background="#444"
                        Command="{Binding CancelRequestCommand}"
                        Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                </Button>

                <!-- URL input -->
                <TextBox Style="{StaticResource UrlTextBox}"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── REQUEST / RESPONSE SPLIT ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Request editor -->
            <views:RequestEditor Grid.Column="0"/>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BrushBorder}"/>

            <!-- RIGHT: Response viewer -->
            <views:ResponseViewer Grid.Column="2"/>
        </Grid>
    </Grid>
</UserControl>
