<UserControl x:Class="PostmanCloneWPFUI.Views.CollectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Margin="4,2" CornerRadius="4">
        <DockPanel>
            <!-- Collection header row -->
            <Border DockPanel.Dock="Top" Padding="8,6" CornerRadius="4" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding ToggleExpandedCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToVis}, FallbackValue='▶'}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="📂" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"
                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="📁" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"
                               Visibility="{Binding IsExpanded, Converter={StaticResource InvertBoolToVis}}"/>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Requests.Count}" FontSize="10"
                               Foreground="{StaticResource BrushTextMuted}"
                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </DockPanel>
            </Border>

            <!-- Request list -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Requests}" Margin="8,0,0,0"
                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,5" CornerRadius="4" Margin="0,1" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenSavedRequestCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Method}" FontSize="9" FontWeight="Bold"
                                           Foreground="{Binding Method, Converter={StaticResource MethodColor}}"
                                           VerticalAlignment="Center" Width="38" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
