<Window x:Class="PostmanCloneWPFUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PostmanCloneWPFUI.ViewModels"
        xmlns:views="clr-namespace:PostmanCloneWPFUI.Views"
        Title="Restify" Height="800" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgBase}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar icon rail -->
            <ColumnDefinition Width="44"/>
            <!-- Sidebar panel -->
            <ColumnDefinition Width="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}, ConverterParameter=220}" x:Name="SidebarCol"/>
            <ColumnDefinition Width="Auto"/>
            <!-- Main content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── ICON RAIL ── -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgDeep}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource BrushBgDeep}">
                    <TextBlock Text="R" FontSize="18" FontWeight="Black"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <!-- Collections -->
                    <Button Style="{StaticResource SidebarNavButton}"
                            Command="{Binding SetSidebarSectionCommand}" CommandParameter="Collections"
                            ToolTip="Collections" Margin="4,2">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding SidebarSection,
                                Converter={StaticResource StringEq}, ConverterParameter=Collections,
                                FallbackValue=Transparent}"/>
                        </Button.Background>
                        <TextBlock Text="📁" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- History -->
                    <Button Style="{StaticResource SidebarNavButton}"
                            Command="{Binding SetSidebarSectionCommand}" CommandParameter="History"
                            ToolTip="History" Margin="4,2">
                        <TextBlock Text="🕐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Environments -->
                    <Button Style="{StaticResource SidebarNavButton}"
                            Command="{Binding SetSidebarSectionCommand}" CommandParameter="Environments"
                            ToolTip="Environments" Margin="4,2">
                        <TextBlock Text="⚙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Toggle sidebar -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SidebarNavButton}"
                        Command="{Binding ToggleSidebarCommand}"
                        ToolTip="Toggle Sidebar" Margin="4,4">
                    <TextBlock FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}, FallbackValue='→'}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- ── SIDEBAR PANEL ── -->
        <Border Grid.Column="1"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- Sidebar header -->
                <Border DockPanel.Dock="Top" Height="44" Padding="12,0"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SidebarSection}" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Command="{Binding AddCollectionCommand}" Content="+" FontSize="16"
                                VerticalAlignment="Center" Padding="4,0"
                                Visibility="{Binding SidebarSection, Converter={StaticResource StringEqVis}, ConverterParameter=Collections}"/>
                    </DockPanel>
                </Border>

                <!-- Collections view -->
                <ScrollViewer Visibility="{Binding SidebarSection, Converter={StaticResource StringEqVis}, ConverterParameter=Collections}"
                              VerticalScrollBarVisibility="Auto" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:CollectionPanel/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- History view -->
                <ScrollViewer Visibility="{Binding SidebarSection, Converter={StaticResource StringEqVis}, ConverterParameter=History}"
                              VerticalScrollBarVisibility="Auto" Margin="0,4">
                    <StackPanel>
                        <TextBlock Text="No history yet" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="12,20" HorizontalAlignment="Center"
                                   Visibility="{Binding History.Count, Converter={StaticResource NullToVis}}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="4,1" CornerRadius="4" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushBgHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Method}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding Method, Converter={StaticResource MethodColor}}"
                                                           VerticalAlignment="Center" Width="42"/>
                                                <TextBlock Text="{Binding Url}" Foreground="{StaticResource BrushTextSecondary}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Environments view -->
                <StackPanel Visibility="{Binding SidebarSection, Converter={StaticResource StringEqVis}, ConverterParameter=Environments}"
                            Margin="12,16">
                    <TextBlock Text="No environments configured" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="2" Width="1" HorizontalAlignment="Stretch"
                      Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>

        <!-- ── MAIN AREA ── -->
        <DockPanel Grid.Column="3">

            <!-- Top tab bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BrushBgDeep}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Height="40">
                <DockPanel>
                    <!-- New tab button -->
                    <Button DockPanel.Dock="Right" Content="+" FontSize="16"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding AddNewTabCommand}"
                            Width="40" ToolTip="New Request"/>

                    <!-- Tab strip -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TabBorder" MinWidth="140" MaxWidth="200" Height="40"
                                            Cursor="Hand" BorderThickness="0,0,1,0"
                                            BorderBrush="{StaticResource BrushBorder}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                                                <Binding />
                                                                <Binding Path="DataContext.ActiveTab"
                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>

                                                        <Setter Property="Background"
            Value="{StaticResource BrushBgBase}" />

                                                        <Setter Property="BorderThickness"
            Value="0,2,1,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                Command="{Binding DataContext.SetActiveTabCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <DockPanel Margin="10,0,4,0" VerticalAlignment="Center">
                                            <Button DockPanel.Dock="Right" Content="✕" FontSize="10"
                                                    Style="{StaticResource GhostButton}" Padding="4,2"
                                                    Command="{Binding DataContext.CloseTabCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Method}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding Method, Converter={StaticResource MethodColor}}"
                                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Active request view -->
            <ContentControl Content="{Binding ActiveTab}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:RequestView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </DockPanel>
    </Grid>
</Window>
