<UserControl x:Class="PostmanCloneWPFUI.Views.ResponseViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BrushBgPanel}">
        <DockPanel>

            <!-- Section label -->
            <Border DockPanel.Dock="Top" Padding="14,8"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="RESPONSE" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>

                    <!-- Status pills (visible when response exists) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
                        <!-- Status code -->
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,0"
                                Background="{Binding ResponseStatus, Converter={StaticResource StatusCodeColor}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ResponseStatus}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                <TextBlock Text=" " FontSize="12" Foreground="White"/>
                                <TextBlock Text="{Binding ResponseStatusText}" FontSize="12" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <!-- Time -->
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,0"
                                Background="{StaticResource BrushBgCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding ResponseElapsedMs, Converter={StaticResource ElapsedTime}}"
                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <!-- Size -->
                        <Border CornerRadius="4" Padding="8,3"
                                Background="{StaticResource BrushBgCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding ResponseSize}"
                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasResponse, Converter={StaticResource InvertBoolToVis}}">
                <TextBlock Text="→" FontSize="48" Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Enter a URL and hit Send" Foreground="{StaticResource BrushTextMuted}"
                           FontSize="14" HorizontalAlignment="Center"/>
                <!-- Spinner during send -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Sending..." Foreground="{StaticResource BrushAccent}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <!-- Response tabs -->
            <TabControl DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                        Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">

                <!-- BODY -->
                <TabItem Header="Body">
                    <DockPanel>
                        <!-- Toolbar -->
                        <Border DockPanel.Dock="Top" Padding="8,5"
                                Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,1">
                            <DockPanel>
                                <TextBlock Text="{Binding ResponseContentType}"
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Copy" Style="{StaticResource GhostButton}" FontSize="11"
                                            Command="{Binding CopyResponseBodyCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Clear" Style="{StaticResource GhostButton}" FontSize="11"
                                            Command="{Binding ClearResponseCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Body text -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox Style="{StaticResource CodeTextBox}"
                                     Text="{Binding ResponseBody, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12"
                                     TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- HEADERS -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Headers "/>
                            <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="8" Padding="5,1">
                                <TextBlock Text="{Binding ResponseHeaders.Count}"
                                           Foreground="{StaticResource BrushAccent}" FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ResponseHeaders}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,1" CornerRadius="4"
                                            Background="{StaticResource BrushBgCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
